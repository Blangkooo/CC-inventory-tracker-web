    {
      "name": "Stock (manager: own, super_admin: any)",
      "item": [
        {
          "name": "Branch Stock Levels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/branches/{{branch_id}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "branches",
                "{{branch_id}}",
                "stock"
              ]
            }
          }
        },
        {
          "name": "Create Initial Stock Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": {{branch_id}},\n  \"ingredient_id\": {{ingredient_id}},\n  \"current_quantity\": 1000,\n  \"min_threshold\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock"
              ]
            }
          }
        },
        {
          "name": "Manual Restock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": {{branch_id}},\n  \"ingredient_id\": {{ingredient_id}},\n  \"quantity\": 500,\n  \"notes\": \"Weekly delivery from supplier\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/stock/restock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "restock"
              ]
            },
            "description": "Additive — adds 'quantity' to whatever is already on hand and logs a 'restock' stock movement."
          }
        },
        {
          "name": "Stock Movement History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/{{branch_stock_id}}/movements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "{{branch_stock_id}}",
                "movements"
              ]
            },
            "description": "{{branch_stock_id}} is a branch_stock row id (the id field from 'Branch Stock Levels' or 'Create Initial Stock Entry' responses) — a full audit trail of every sale, restock, and shift correction for that branch+ingredient."
          }
        },
        {
          "name": "Low Stock Helper",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stock/low-stock?branch_id={{branch_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stock",
                "low-stock"
              ],
              "query": [
                {
                  "key": "branch_id",
                  "value": "{{branch_id}}"
                }
              ]
            },
            "description": "Returns every branch_stock row currently at or below its min_threshold."
          }
        }
      ]
    },
