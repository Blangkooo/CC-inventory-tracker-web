{
  "info": {
    "name": "Multi-Branch Inventory Tracker API",
    "description": "Complete endpoint collection for the Multi-Branch Inventory Tracker backend (Laravel + JWT + 3-tier RBAC: super_admin / manager / staff). Run the two Login requests first — they auto-save the JWT into {{admin_token}} / {{staff_token}} via a test script, so every other request just works.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "staff_token",
      "value": ""
    },
    {
      "key": "branch_id",
      "value": "1"
    },
    {
      "key": "other_branch_id",
      "value": "2"
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "ingredient_id",
      "value": "1"
    },
    {
      "key": "recipe_id",
      "value": "1"
    },
    {
      "key": "staff_id",
      "value": "3"
    },
    {
      "key": "shift_log_id",
      "value": "1"
    },
    {
      "key": "alert_id",
      "value": "1"
    },
    {
      "key": "notification_id",
      "value": "1"
    },
    {
      "key": "transaction_id",
      "value": "1"
    },
    {
      "key": "receipt_id",
      "value": "1"
    },
    {
      "key": "branch_stock_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login (super_admin / manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('admin_token', json.token); }",
                  "pm.test('Token present', () => pm.expect(json.token).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@inventory.test\",\n  \"password\": \"123456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin-login"
              ]
            },
            "description": "Also works for a manager account, e.g. manager@inventory.test / 123456789."
          }
        },
        {
          "name": "Staff Login (pin + branch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('staff_token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"123456789\",\n  \"branch_id\": {{branch_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/staff-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "staff-login"
              ]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
